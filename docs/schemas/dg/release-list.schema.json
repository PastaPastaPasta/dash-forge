{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PastaPastaPasta/dash-forge/blob/master/docs/schemas/dg/release-list.schema.json",
  "title": "dg release list --json",
  "description": "The repository's releases.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "count": {
      "type": "integer"
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "previous": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "hidden": {},
    "earlierUse": {},
    "stale": {},
    "assetListLateCheckError": {}
  },
  "required": [
    "schemaVersion",
    "count",
    "releases"
  ],
  "additionalProperties": true
}
