{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/make-public.schema.json",
  "title": "dg make-public --json",
  "description": "Members-only posts made public: your own each edited to Public (a review given a public comment that carries its text), or anyone's by a maintainer's make-public bundle (`carrier` \"bundle\").",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "madePublic"
      ]
    },
    "cost": {
      "$ref": "common.schema.json#/$defs/cost"
    },
    "carrier": {
      "type": "string",
      "enum": [
        "bundle"
      ]
    },
    "manifest": {
      "type": "string",
      "description": "The bundle's packManifest document id."
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "posts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "issue",
              "comment",
              "review"
            ]
          },
          "number": {
            "type": [
              "integer",
              "null"
            ]
          },
          "written": {
            "type": "string"
          },
          "lost": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "author": {
            "type": "string"
          },
          "revisions": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        },
        "required": [
          "id",
          "kind"
        ]
      }
    },
    "leftOut": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "why": {
            "type": "string",
            "enum": [
              "alreadyPublic",
              "unreadable",
              "notSent",
              "longBody",
              "pullRequest"
            ]
          }
        },
        "required": [
          "id",
          "why"
        ]
      },
      "description": "Posts named that the bundle leaves out, and why."
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "posts"
  ],
  "additionalProperties": true
}
