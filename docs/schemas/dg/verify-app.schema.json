{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PastaPastaPasta/dash-forge/blob/master/docs/schemas/dg/verify-app.schema.json",
  "title": "dg verify-app --json",
  "description": "A deployed copy of the web app checked against a published build.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "url": {
      "type": "string"
    },
    "manifest": {},
    "source": {},
    "commit": {},
    "network": {},
    "variant": {},
    "servedManifestAgrees": {},
    "files": {},
    "matched": {},
    "differ": {},
    "missing": {},
    "ok": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "url",
    "ok"
  ],
  "additionalProperties": true
}
