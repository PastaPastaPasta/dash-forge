{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/org-list.schema.json",
  "title": "dg org list --json",
  "description": "The organizations connected on this computer or found through the signed-in identity's orgMember documents, for the network (public values only).",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "network": {
      "type": "string"
    },
    "orgs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "network": {
            "type": "string"
          },
          "orgId": {
            "type": "string"
          },
          "room": {
            "type": "string"
          },
          "relay": {
            "type": "string"
          },
          "authPub": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "threshold": {
            "type": "integer"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "authPub": {
                  "type": "string"
                }
              },
              "required": [
                "index",
                "name",
                "authPub"
              ]
            }
          },
          "dismissed": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Requests dismissed on this computer."
          }
        },
        "required": [
          "network",
          "orgId",
          "room",
          "relay",
          "authPub",
          "label",
          "threshold",
          "members"
        ]
      }
    },
    "connectAgain": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Organizations the signed-in identity is bound to whose current key no longer includes its member key."
    }
  },
  "required": [
    "schemaVersion",
    "network",
    "orgs"
  ],
  "additionalProperties": true
}
