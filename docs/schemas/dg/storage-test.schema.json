{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PastaPastaPasta/dash-forge/blob/master/docs/schemas/dg/storage-test.schema.json",
  "title": "dg storage test --json",
  "description": "A storage profile tried end to end.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "profile": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "fixes": {}
  },
  "required": [
    "schemaVersion",
    "profile",
    "ok"
  ],
  "additionalProperties": true
}
