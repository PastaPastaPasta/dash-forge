{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/branch-list.schema.json",
  "title": "dg branch list --json",
  "description": "The repository's branches and who can see them. A member sees the members-only ones too, a branch for fewer people with who it is for when they hold its key, and counts the others in `noAccessBranches`; anyone else sees `alsoMembersOnly` instead (never how many).",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repo": {
      "type": "string"
    },
    "branches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "tip": {
            "type": [
              "string",
              "null"
            ]
          },
          "audience": {
            "type": "string",
            "enum": [
              "public",
              "members",
              "narrower"
            ]
          },
          "audienceLabel": {
            "type": "string",
            "description": "Who a branch for fewer people is for (\"Maintainers\")."
          },
          "visibleTo": {
            "type": "integer",
            "description": "How many people it is for now."
          }
        },
        "required": [
          "name",
          "ref",
          "audience"
        ]
      }
    },
    "alsoMembersOnly": {
      "type": "boolean"
    },
    "noAccessBranches": {
      "type": "integer",
      "description": "Branches for fewer people this reader has no key for (one per key generation)."
    }
  },
  "required": [
    "schemaVersion",
    "repo",
    "branches",
    "alsoMembersOnly"
  ],
  "additionalProperties": true
}
