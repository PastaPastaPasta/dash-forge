{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PastaPastaPasta/dash-forge/blob/master/docs/schemas/dg/env-history.schema.json",
  "title": "dg env history --json",
  "description": "An environment's saved versions.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "env": {
      "type": "string"
    },
    "state": {},
    "heads": {},
    "changes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "ignored": {}
  },
  "required": [
    "schemaVersion",
    "env",
    "changes"
  ],
  "additionalProperties": true
}
