{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PastaPastaPasta/dash-forge/blob/master/docs/schemas/dg/env-export.schema.json",
  "title": "dg env export --json",
  "description": "An environment written to a file.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "written"
      ]
    },
    "env": {
      "type": "string"
    },
    "file": {
      "type": "string"
    },
    "entries": {
      "type": "integer"
    },
    "mode": {
      "type": "string"
    },
    "ignored": {}
  },
  "required": [
    "schemaVersion",
    "status",
    "env",
    "file"
  ],
  "additionalProperties": true
}
