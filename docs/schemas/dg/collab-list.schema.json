{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PastaPastaPasta/dash-forge/blob/master/docs/schemas/dg/collab-list.schema.json",
  "title": "dg collab list --json",
  "description": "The repository's members and their roles.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "count": {
      "type": "integer"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "ownerId": {
      "type": "string"
    },
    "roles": {
      "const": true
    }
  },
  "required": [
    "schemaVersion",
    "count",
    "members",
    "ownerId",
    "roles"
  ],
  "additionalProperties": true
}
