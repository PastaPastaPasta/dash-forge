{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/bot-read.schema.json",
  "title": "dg bot read --json",
  "description": "As a bot: one request's thread as you were given it.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "request": {
      "type": "string"
    },
    "number": {
      "type": "integer"
    },
    "asker": {
      "type": "string"
    },
    "task": {
      "type": [
        "string",
        "null"
      ]
    },
    "at": {
      "type": "integer"
    },
    "letter": {
      "type": [
        "string",
        "null"
      ]
    },
    "asOf": {
      "type": [
        "integer",
        "null"
      ]
    },
    "head": {
      "type": [
        "string",
        "null"
      ]
    },
    "packs": {
      "type": "integer"
    },
    "packFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "posts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "pull request",
              "issue",
              "comment",
              "review"
            ]
          },
          "id": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "at": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "public",
              "membersOnly",
              "notShared",
              "after"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "body": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "kind",
          "id",
          "author",
          "at",
          "status"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "request",
    "number",
    "asker",
    "at",
    "packs",
    "posts"
  ],
  "additionalProperties": true
}
