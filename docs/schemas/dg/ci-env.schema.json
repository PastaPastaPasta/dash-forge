{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/ci-env.schema.json",
  "title": "dg ci env --json",
  "description": "An environment's values, for a CI runner it is shared with by name (what forge-runner reads).",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "env": {
      "type": "string"
    },
    "id": {
      "type": [
        "string",
        "null"
      ]
    },
    "updatedBy": {
      "type": "string"
    },
    "updatedAt": {
      "type": "integer"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "secret",
              "variable"
            ]
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "type",
          "value"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "env",
    "entries"
  ],
  "additionalProperties": true
}
