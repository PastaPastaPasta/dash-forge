{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/repack.schema.json",
  "title": "dg repack --json",
  "description": "The repository's packs combined into one.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "repacked"
      ]
    },
    "repoId": {
      "type": "string"
    },
    "newPackHash": {
      "type": "string"
    },
    "newManifestId": {
      "type": "string"
    },
    "locatorManifestId": {},
    "newPackBytes": {
      "type": "integer"
    },
    "objectCount": {
      "type": "integer"
    },
    "newUris": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersededCount": {
      "type": "integer"
    },
    "supersededBytes": {
      "type": "integer"
    },
    "unnamedLivePacks": {},
    "deletedDocuments": {
      "type": "integer"
    },
    "cost": {
      "$ref": "common.schema.json#/$defs/cost"
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "repoId"
  ],
  "additionalProperties": true
}
