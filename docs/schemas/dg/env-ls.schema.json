{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/env-ls.schema.json",
  "title": "dg env ls --json",
  "description": "The repository's environments, or one environment's variables (names and types, not values).",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "hidden": {},
    "ignored": {},
    "env": {
      "type": "string"
    },
    "audience": {},
    "to": {},
    "updatedBy": {
      "type": "string"
    },
    "oldFormat": {},
    "needsSaving": {},
    "updatedAt": {
      "type": "integer"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "required": [
    "schemaVersion"
  ],
  "additionalProperties": true
}
