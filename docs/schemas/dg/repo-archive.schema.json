{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/repo-archive.schema.json",
  "title": "dg repo archive --json",
  "description": "The repository archived (read-only).",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "type": "string"
    },
    "repo": {
      "type": "string"
    },
    "archived": {
      "type": "boolean"
    },
    "configDocumentId": {
      "type": [
        "string",
        "null"
      ]
    },
    "cost": {
      "$ref": "common.schema.json#/$defs/cost"
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "repo",
    "archived"
  ],
  "additionalProperties": true
}
