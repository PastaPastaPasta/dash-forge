{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/issue-comment.schema.json",
  "title": "dg issue comment --json",
  "description": "A comment posted.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "commented"
      ]
    },
    "issue": {
      "type": "integer"
    },
    "commentId": {
      "type": "string"
    },
    "audience": {
      "$ref": "common.schema.json#/$defs/audience"
    },
    "cost": {
      "$ref": "common.schema.json#/$defs/cost"
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "issue",
    "commentId"
  ],
  "additionalProperties": true
}
