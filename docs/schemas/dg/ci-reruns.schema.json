{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PastaPastaPasta/dash-forge/blob/master/docs/schemas/dg/ci-reruns.schema.json",
  "title": "dg ci reruns --json",
  "description": "The re-run requests written since a time.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "since": {
      "type": "integer"
    },
    "count": {
      "type": "integer"
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "schemaVersion",
    "count",
    "requests"
  ],
  "additionalProperties": true
}
