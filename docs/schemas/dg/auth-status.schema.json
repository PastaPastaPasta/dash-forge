{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/auth-status.schema.json",
  "title": "dg auth status --json",
  "description": "Who is signed in on this computer, and the key's limits.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "network": {
      "type": "string"
    },
    "authenticated": {
      "type": "boolean"
    },
    "identityId": {
      "type": "string"
    },
    "names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "keyId": {
      "type": [
        "integer",
        "null"
      ]
    },
    "keyDisabled": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "limited": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "capped": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "boundDocumentType": {
      "type": [
        "string",
        "null"
      ]
    },
    "encryptionKeyIds": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "budgetCredits": {
      "type": [
        "integer",
        "null"
      ]
    },
    "budgetRemainingCredits": {
      "type": [
        "integer",
        "null"
      ]
    },
    "expiresAt": {
      "type": [
        "integer",
        "null"
      ]
    },
    "balanceCredits": {
      "type": [
        "integer",
        "null"
      ]
    },
    "balanceDash": {
      "type": [
        "number",
        "null"
      ]
    },
    "storage": {
      "type": [
        "string",
        "null"
      ]
    },
    "storedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "defaultIdentityId": {
      "type": [
        "string",
        "null"
      ]
    },
    "masterKeyStored": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "keyUnopened": {
      "type": [
        "string",
        "null"
      ],
      "description": "Why the stored key could not be opened here (it is sealed and no passphrase is available), or null."
    },
    "keyOrigin": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "wallet",
            "phrase",
            "file",
            "dfk1",
            "keychain"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "Where the key came from: `wallet` (a DashPay wallet granted it), `phrase` or `file` (dg registered it, or stored the identity, from the recovery phrase or an identity file), `dfk1` (an inline DASH_FORGE_KEY), `keychain` (in the OS keychain, origin not recorded); null for a pasted key, a key file an earlier dg stored without recording its origin, or no key."
    },
    "renew": {
      "type": [
        "string",
        "null"
      ],
      "description": "The command that renews a wallet-granted key, else null."
    },
    "orgRequestsWaiting": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Requests in the organizations connected here that wait for your signature; null when none is connected (or on mainnet)."
    }
  },
  "required": [
    "schemaVersion",
    "network",
    "authenticated"
  ],
  "additionalProperties": true
}
