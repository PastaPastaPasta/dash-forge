{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PastaPastaPasta/dash-forge/blob/master/docs/schemas/dg/pr-diff.schema.json",
  "title": "dg pr diff --json",
  "description": "The pull request's diff.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "pr": {
      "type": "integer"
    },
    "range": {
      "type": "string"
    },
    "diffAvailable": {
      "type": "boolean"
    },
    "diff": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "pr",
    "diff"
  ],
  "additionalProperties": true
}
