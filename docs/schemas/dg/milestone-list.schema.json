{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/milestone-list.schema.json",
  "title": "dg milestone list --json",
  "description": "The repository's milestones.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "count": {
      "type": "integer"
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "dueOn": {},
          "closed": {},
          "open": {},
          "closedItems": {}
        },
        "required": [
          "title"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "count",
    "milestones"
  ],
  "additionalProperties": true
}
