{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PastaPastaPasta/dash-forge/blob/master/docs/schemas/dg/search-repos.schema.json",
  "title": "dg search repos --json",
  "description": "Repositories matching a query.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "count": {
      "type": "integer"
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ownerId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "repoId": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "private"
            ]
          }
        },
        "required": [
          "ownerId",
          "name",
          "repoId"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "count",
    "repos"
  ],
  "additionalProperties": true
}
