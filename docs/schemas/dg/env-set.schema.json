{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PastaPastaPasta/dash-forge/blob/master/docs/schemas/dg/env-set.schema.json",
  "title": "dg env set --json",
  "description": "A variable set.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "saved",
        "unchanged"
      ]
    },
    "env": {
      "type": "string"
    },
    "audience": {},
    "to": {},
    "skipped": {},
    "changes": {},
    "id": {
      "type": "string"
    },
    "packHash": {
      "type": "string"
    },
    "sizeBytes": {
      "type": "integer"
    },
    "quote": {
      "$ref": "common.schema.json#/$defs/cost"
    },
    "spent": {
      "$ref": "common.schema.json#/$defs/cost"
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "env"
  ],
  "additionalProperties": true
}
