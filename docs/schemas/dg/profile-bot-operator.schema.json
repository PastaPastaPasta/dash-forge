{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/profile-bot-operator.schema.json",
  "title": "dg profile bot operator --json",
  "description": "Your profile names (or stops naming) the identity that operates it as a bot.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "created",
        "updated",
        "unchanged"
      ]
    },
    "documentId": {
      "type": "string"
    },
    "bot": {
      "type": "object",
      "properties": {
        "operator": {
          "type": "string"
        },
        "operates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "The signer's bot claim as written: the identity that operates it, and the bots it operates."
    },
    "cost": {
      "$ref": "common.schema.json#/$defs/cost"
    }
  },
  "required": [
    "schemaVersion",
    "status"
  ],
  "additionalProperties": true
}
