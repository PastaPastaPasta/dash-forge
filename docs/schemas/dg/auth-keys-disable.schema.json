{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/auth-keys-disable.schema.json",
  "title": "dg auth keys disable --json",
  "description": "A key (or, with --all-limited, every limited key) disabled on the identity.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "disabled",
        "already_disabled",
        "nothing_to_disable"
      ]
    },
    "keyId": {
      "type": "integer"
    },
    "keyIds": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "keptKeyId": {
      "type": [
        "integer",
        "null"
      ]
    },
    "updates": {
      "type": "integer"
    },
    "cost": {
      "$ref": "common.schema.json#/$defs/cost"
    }
  },
  "required": [
    "schemaVersion",
    "status"
  ],
  "additionalProperties": true
}
