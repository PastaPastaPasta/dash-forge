{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PastaPastaPasta/dash-forge/blob/master/docs/schemas/dg/repo-members-status.schema.json",
  "title": "dg repo members status --json",
  "description": "Whether members-only content is on, and who has no key yet.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repo": {
      "type": "string"
    },
    "on": {
      "type": "boolean"
    },
    "epoch": {},
    "youCanRead": {
      "type": "boolean"
    },
    "noKeyYet": {}
  },
  "required": [
    "schemaVersion",
    "repo",
    "on"
  ],
  "additionalProperties": true
}
