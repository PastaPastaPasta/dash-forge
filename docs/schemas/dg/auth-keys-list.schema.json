{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PastaPastaPasta/dash-forge/blob/master/docs/schemas/dg/auth-keys-list.schema.json",
  "title": "dg auth keys list --json",
  "description": "The identity's keys.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "identityId": {
      "type": "string"
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "schemaVersion",
    "identityId",
    "keys"
  ],
  "additionalProperties": true
}
