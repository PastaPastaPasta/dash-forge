{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/pr-ready.schema.json",
  "title": "dg pr ready --json",
  "description": "A draft marked ready for review.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "type": "string"
    },
    "pr": {
      "type": "integer"
    },
    "written": {
      "type": "boolean"
    },
    "draft": {
      "type": "boolean"
    },
    "via": {},
    "transitionId": {
      "type": "string"
    },
    "kind": {},
    "cost": {
      "$ref": "common.schema.json#/$defs/cost"
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "pr",
    "written"
  ],
  "additionalProperties": true
}
