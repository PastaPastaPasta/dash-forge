{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PastaPastaPasta/dash-forge/blob/master/docs/schemas/dg/webhook-list.schema.json",
  "title": "dg webhook list --json",
  "description": "The repository's webhooks.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repo": {
      "type": "string"
    },
    "count": {
      "type": "integer"
    },
    "webhooks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "schemaVersion",
    "repo",
    "count",
    "webhooks"
  ],
  "additionalProperties": true
}
