{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PastaPastaPasta/dash-forge/blob/master/docs/schemas/dg/repo-view.schema.json",
  "title": "dg repo view --json",
  "description": "A repository: its refs, packs and members.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repoId": {
      "type": "string"
    },
    "ownerId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ]
    },
    "archived": {
      "type": "boolean"
    },
    "defaultBranch": {
      "type": [
        "string",
        "null"
      ]
    },
    "refs": {},
    "packCount": {
      "type": "integer"
    },
    "packBytes": {
      "type": "integer"
    },
    "members": {},
    "remoteUrl": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "repoId",
    "ownerId",
    "name",
    "visibility"
  ],
  "additionalProperties": true
}
