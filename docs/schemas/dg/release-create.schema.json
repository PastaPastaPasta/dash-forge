{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/release-create.schema.json",
  "title": "dg release create --json",
  "description": "A release published.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "type": "string"
    },
    "tag": {
      "type": "string"
    },
    "sealed": {
      "type": "boolean"
    },
    "documentId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "assets": {
      "type": "array",
      "items": {}
    },
    "assetListKept": {},
    "assetListReused": {},
    "warnings": {},
    "cost": {
      "$ref": "common.schema.json#/$defs/cost"
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "tag",
    "documentId"
  ],
  "additionalProperties": true
}
