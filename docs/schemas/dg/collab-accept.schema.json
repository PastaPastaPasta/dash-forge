{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PastaPastaPasta/dash-forge/blob/master/docs/schemas/dg/collab-accept.schema.json",
  "title": "dg collab accept --json",
  "description": "An invitation accepted (or withdrawn).",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "type": "string"
    },
    "repo": {
      "type": "string"
    },
    "identityId": {
      "type": "string"
    },
    "documentId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "cost": {
      "$ref": "common.schema.json#/$defs/cost"
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "repo"
  ],
  "additionalProperties": true
}
