{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/storage-add.schema.json",
  "title": "dg storage add --json",
  "description": "A storage profile added.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "added",
        "replaced"
      ]
    },
    "profile": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "unresolvedSecrets": {},
    "warnings": {},
    "allowPrivateUri": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "profile"
  ],
  "additionalProperties": true
}
