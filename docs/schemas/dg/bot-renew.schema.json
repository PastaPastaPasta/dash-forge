{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/bot-renew.schema.json",
  "title": "dg bot renew --json",
  "description": "A bot's push access renewed: a new grant per branch or prefix, and the notice listing them (or, for a suspended bot, the new grants only).",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "bot": {
      "type": "string"
    },
    "may": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What the bot may do: post, postMembersOnly, readOnRequest, ciMembersBranches (and abilities a later version adds)."
    },
    "askers": {
      "type": "string",
      "enum": [
        "writers",
        "maintainers"
      ]
    },
    "threads": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "all"
          ]
        },
        {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      ],
      "description": "\"all\", or the issue and pull request numbers it may be asked about."
    },
    "processor": {
      "type": [
        "string",
        "null"
      ]
    },
    "until": {
      "type": [
        "integer",
        "null"
      ]
    },
    "line": {
      "type": "string",
      "description": "The access as everyone reads it."
    },
    "push": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "grant": {
            "type": "string"
          },
          "target": {
            "type": "object",
            "description": "{\"prefix\": ref prefix} or {\"members\": name hash, hex}."
          }
        },
        "required": [
          "grant",
          "target"
        ]
      },
      "description": "The push access the notice lists: each grant's id (hex) and what it covers."
    },
    "notice": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The notice's packManifest document ids (a private repository stores two copies)."
    },
    "packHash": {
      "type": "string"
    },
    "cost": {
      "$ref": "common.schema.json#/$defs/cost"
    },
    "status": {
      "type": "string",
      "enum": [
        "renewed"
      ]
    },
    "renewed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "grant": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "until": {
            "type": "integer"
          }
        },
        "required": [
          "grant",
          "branch",
          "until"
        ]
      },
      "description": "The new grants (only when the bot is suspended: no notice is written)."
    },
    "suspended": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "status"
  ],
  "additionalProperties": true
}
