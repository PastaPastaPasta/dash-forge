{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/board-create.schema.json",
  "title": "dg board create --json",
  "description": "A board created (`exists`: an earlier run of the same create had already made it).",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "created",
        "exists"
      ]
    },
    "key": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "documentId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cost": {
      "$ref": "common.schema.json#/$defs/cost"
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "key",
    "documentId"
  ],
  "additionalProperties": true
}
