{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/ci-status.schema.json",
  "title": "dg ci status --json",
  "description": "The newest check run per name on a commit.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "headOid": {
      "type": "string"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "headOid",
    "checks"
  ],
  "additionalProperties": true
}
