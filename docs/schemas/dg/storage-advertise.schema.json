{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PastaPastaPasta/dash-forge/blob/master/docs/schemas/dg/storage-advertise.schema.json",
  "title": "dg storage advertise --json",
  "description": "The storage the repository advertises to forks and mirrors.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "advertised",
        "unchanged"
      ]
    },
    "mode": {},
    "uris": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "configDocId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "status"
  ],
  "additionalProperties": true
}
