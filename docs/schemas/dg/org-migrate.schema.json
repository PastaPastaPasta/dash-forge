{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/org-migrate.schema.json",
  "title": "dg org migrate --json",
  "description": "Your own messages in the relay's open requests copied to Platform.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "migrated",
        "nothing"
      ]
    },
    "org": {
      "type": "string"
    },
    "posted": {
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "posted"
  ],
  "additionalProperties": true
}
