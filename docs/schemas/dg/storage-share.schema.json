{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/storage-share.schema.json",
  "title": "dg storage share --json",
  "description": "The storage a repository’s maintainers get, set or stopped, and who has it.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "shared",
        "stopped"
      ]
    },
    "repo": {
      "type": "string"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "epoch": {
      "type": "integer"
    },
    "granted": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "waiting": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revoked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "repo",
    "epoch"
  ],
  "additionalProperties": true
}
