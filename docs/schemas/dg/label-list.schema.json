{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/label-list.schema.json",
  "title": "dg label list --json",
  "description": "The repository's labels.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "count": {
      "type": "integer"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "color": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "retired": {
            "type": "boolean"
          }
        },
        "required": [
          "name"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "count",
    "labels"
  ],
  "additionalProperties": true
}
