{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/repo-star.schema.json",
  "title": "dg repo star --json",
  "description": "The repository starred.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "type": "string"
    },
    "repo": {
      "type": "string"
    },
    "starred": {
      "type": "boolean"
    },
    "stars": {
      "type": [
        "integer",
        "null"
      ]
    },
    "cost": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/cost"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "repo"
  ],
  "additionalProperties": true
}
