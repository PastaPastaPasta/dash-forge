{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/issue-view.schema.json",
  "title": "dg issue view --json",
  "description": "An issue, its comments, events and state.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "number": {
      "type": "integer"
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "body": {
      "type": [
        "string",
        "null"
      ]
    },
    "bodyIncomplete": {},
    "author": {
      "type": "string"
    },
    "documentId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "audience": {
      "$ref": "common.schema.json#/$defs/audience"
    },
    "letter": {
      "$ref": "common.schema.json#/$defs/letter"
    },
    "recipients": {
      "type": [
        "integer",
        "null"
      ]
    },
    "readable": {
      "type": "boolean"
    },
    "why": {
      "type": "string"
    },
    "createdAt": {
      "type": "integer"
    },
    "state": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ]
    },
    "open": {
      "type": "boolean"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assignees": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stateReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "duplicateOf": {
      "type": [
        "integer",
        "null"
      ]
    },
    "milestone": {
      "type": [
        "string",
        "null"
      ]
    },
    "pinned": {
      "type": "boolean"
    },
    "locked": {
      "type": "boolean"
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "body": {
            "type": [
              "string",
              "null"
            ]
          },
          "bodyIncomplete": {},
          "audience": {
            "$ref": "common.schema.json#/$defs/audience"
          },
          "letter": {
            "$ref": "common.schema.json#/$defs/letter"
          },
          "replyTo": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "integer"
          },
          "madePublic": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "by": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "public",
                      "editedAfter"
                    ]
                  },
                  "publishedRevision": {
                    "type": "integer"
                  }
                },
                "required": [
                  "by",
                  "state"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "author"
        ]
      }
    },
    "membersOnlyComments": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "membersOnlyHidden": {
      "type": "integer"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "integer"
          }
        }
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {},
          "actor": {
            "type": "string"
          },
          "asAuthor": {},
          "createdAt": {
            "type": "integer"
          },
          "reason": {},
          "dupNumber": {},
          "closedIn": {}
        }
      }
    },
    "hiddenComments": {},
    "moderation": {},
    "hiddenEventValues": {},
    "plaintextEventValues": {},
    "madePublic": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "by": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "public",
                "editedAfter"
              ]
            },
            "publishedRevision": {
              "type": "integer"
            }
          },
          "required": [
            "by",
            "state"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "Who made this members-only issue public with a make-public bundle, and whether its author edited it since; null when no maintainer did."
    },
    "earlierVersions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "revision": {
            "type": [
              "integer",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "body": {
            "type": [
              "string",
              "null"
            ]
          },
          "updatedAt": {
            "type": [
              "integer",
              "null"
            ]
          },
          "madePublicBy": {
            "type": "string"
          }
        },
        "required": [
          "madePublicBy"
        ]
      },
      "description": "With --history: the earlier versions of the issue a maintainer made public, oldest first."
    },
    "bundleAlerts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "by": {
            "type": "string"
          }
        },
        "required": [
          "documentId",
          "revision",
          "by"
        ]
      },
      "description": "Make-public entries whose key does not match the post they name: ignored."
    }
  },
  "required": [
    "schemaVersion",
    "number",
    "author",
    "id",
    "readable",
    "state",
    "open",
    "labels",
    "assignees"
  ],
  "additionalProperties": true
}
