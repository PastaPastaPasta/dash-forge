{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/storage-use.schema.json",
  "title": "dg storage use --json",
  "description": "Which storage profiles pushes use.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "storage": {
      "type": "string",
      "description": "The profiles pushes store on, comma-separated, as git config `dash.storage` holds them."
    },
    "replicas": {},
    "platformFallback": {},
    "scope": {
      "type": "string",
      "enum": [
        "global",
        "repo"
      ]
    },
    "warnings": {},
    "advertisedMode": {},
    "existingPacks": {}
  },
  "required": [
    "schemaVersion",
    "storage",
    "scope"
  ],
  "additionalProperties": true
}
