{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PastaPastaPasta/dash-forge/blob/master/docs/schemas/dg/repo-members-enable.schema.json",
  "title": "dg repo members enable --json",
  "description": "Members-only content turned on.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "enabled",
        "finished",
        "already_on"
      ]
    },
    "repo": {
      "type": "string"
    },
    "epoch": {},
    "wrapped": {},
    "skipped": {},
    "cost": {
      "$ref": "common.schema.json#/$defs/cost"
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "repo"
  ],
  "additionalProperties": true
}
