{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/storage-sync-move-key.schema.json",
  "title": "dg storage sync move-key --json",
  "description": "Synced settings moved to a new sync key.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "moved"
      ]
    },
    "identityId": {
      "type": "string"
    },
    "keyId": {
      "type": "integer"
    },
    "disabledKeyId": {
      "type": [
        "integer",
        "null"
      ],
      "description": "The key this run disabled; null when an earlier run or another device already moved."
    },
    "resealed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Slots sealed again under the new key."
    },
    "created": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Slots created empty under the new key."
    },
    "shares": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Repositories whose shared storage moved to a new epoch."
    },
    "grantsRewritten": {
      "type": "integer"
    },
    "grantsDropped": {
      "type": "integer"
    },
    "storedAt": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "identityId",
    "keyId",
    "storedAt"
  ],
  "additionalProperties": true
}
