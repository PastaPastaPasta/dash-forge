{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/profile-set.schema.json",
  "title": "dg profile set --json",
  "description": "Your profile changed (with --owner: the request the organization's members sign for it, status `requested`).",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "org": {
      "type": "string"
    },
    "orgId": {
      "type": "string"
    },
    "requestId": {
      "type": "string",
      "description": "The request the members sign with `dg org sign <requestId>`."
    },
    "title": {
      "type": "string"
    },
    "collected": {
      "type": "integer"
    },
    "threshold": {
      "type": "integer"
    },
    "signCommand": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "documentId": {
      "type": "string"
    },
    "fields": {
      "type": "object"
    },
    "cost": {
      "$ref": "common.schema.json#/$defs/cost"
    }
  },
  "required": [
    "schemaVersion",
    "status"
  ],
  "additionalProperties": true
}
