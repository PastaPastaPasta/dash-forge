{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/storage-list.schema.json",
  "title": "dg storage list --json",
  "description": "The storage profiles.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "path": {
      "type": "string"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "ipfsGateways": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "profiles"
  ],
  "additionalProperties": true
}
