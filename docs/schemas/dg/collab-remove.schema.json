{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/collab-remove.schema.json",
  "title": "dg collab remove --json",
  "description": "A member removed (on an organization's repository: the request for it).",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "org": {
      "type": "string"
    },
    "orgId": {
      "type": "string"
    },
    "requestId": {
      "type": "string",
      "description": "The request the members sign with `dg org sign <requestId>`."
    },
    "title": {
      "type": "string"
    },
    "collected": {
      "type": "integer"
    },
    "threshold": {
      "type": "integer"
    },
    "signCommand": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "removed",
        "not_a_member",
        "requested"
      ]
    },
    "member": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "repo": {
      "type": "string"
    },
    "rotation": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/rotation"
        },
        {
          "type": "null"
        }
      ]
    },
    "droppedEpochs": {},
    "losingMembers": {},
    "environments": {},
    "resavedEnvironments": {},
    "environmentPlan": {},
    "branchesShared": {
      "description": "Branches for fewer people the removal renewed the key of, as for `collab add`."
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "member"
  ],
  "additionalProperties": true
}
