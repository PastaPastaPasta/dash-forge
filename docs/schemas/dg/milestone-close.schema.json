{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PastaPastaPasta/dash-forge/blob/master/docs/schemas/dg/milestone-close.schema.json",
  "title": "dg milestone close --json",
  "description": "A milestone closed.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "closed": {
      "type": "boolean"
    },
    "documentId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "cost": {
      "$ref": "common.schema.json#/$defs/cost"
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "title"
  ],
  "additionalProperties": true
}
