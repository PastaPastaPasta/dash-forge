{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PastaPastaPasta/dash-forge/blob/master/docs/schemas/dg/repo-clone.schema.json",
  "title": "dg repo clone --json",
  "description": "Where the repository was cloned.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "remoteUrl": {
      "type": "string"
    },
    "directory": {
      "type": "string"
    },
    "network": {
      "type": "string"
    },
    "gitConfig": {}
  },
  "required": [
    "schemaVersion",
    "remoteUrl",
    "directory"
  ],
  "additionalProperties": true
}
