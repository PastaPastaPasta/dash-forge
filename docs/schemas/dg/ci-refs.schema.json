{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/ci-refs.schema.json",
  "title": "dg ci refs --json",
  "description": "The repository's live refs, their commits and who can see each. A member's identity reads the members-only ones too (`membersView`), by their real names and commits.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repo": {
      "type": "string"
    },
    "membersView": {
      "type": "boolean"
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string"
          },
          "tip": {
            "type": "string"
          },
          "audience": {
            "type": "string",
            "enum": [
              "public",
              "members",
              "private"
            ]
          }
        },
        "required": [
          "ref",
          "tip",
          "audience"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "repo",
    "membersView",
    "refs"
  ],
  "additionalProperties": true
}
