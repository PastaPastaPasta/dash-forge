{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/issue-reopen.schema.json",
  "title": "dg issue reopen --json",
  "description": "An issue reopened.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "type": "string"
    },
    "issue": {
      "type": "integer"
    },
    "via": {},
    "transitionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {},
    "open": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "state": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "open",
            "closed"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "stateReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "duplicateOf": {
      "type": [
        "integer",
        "null"
      ]
    },
    "written": {
      "type": "boolean"
    },
    "cost": {
      "$ref": "common.schema.json#/$defs/cost"
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "issue"
  ],
  "additionalProperties": true
}
