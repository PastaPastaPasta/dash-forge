{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/pr-edit.schema.json",
  "title": "dg pr edit --json",
  "description": "A pull request's title, body or metadata edited.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "edited",
        "unchanged"
      ]
    },
    "pr": {
      "type": "integer"
    },
    "written": {
      "type": "boolean"
    },
    "title": {},
    "bodyChanged": {
      "type": "boolean"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "eventIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unchanged": {},
    "cost": {
      "$ref": "common.schema.json#/$defs/cost"
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "pr"
  ],
  "additionalProperties": true
}
