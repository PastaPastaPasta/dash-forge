{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/storage-mirror-add.schema.json",
  "title": "dg storage mirror add --json",
  "description": "A pack mirror recorded.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "recorded"
      ]
    },
    "repo": {
      "type": "string"
    },
    "packHash": {
      "type": "string"
    },
    "uris": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "documentId": {
      "type": "string"
    },
    "cost": {
      "$ref": "common.schema.json#/$defs/cost"
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "packHash",
    "uris",
    "documentId",
    "cost"
  ],
  "additionalProperties": true
}
