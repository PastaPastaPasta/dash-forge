{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/branch-new.schema.json",
  "title": "dg branch new --json",
  "description": "A branch started in this clone, and who will see it once pushed (null: what the repository decides; `narrower`: fewer people than all members, `--to`).",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "created"
      ]
    },
    "branch": {
      "type": "string"
    },
    "audience": {
      "anyOf": [
        {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/audience"
            },
            {
              "type": "null"
            }
          ]
        },
        {
          "type": "string",
          "enum": [
            "narrower"
          ]
        }
      ]
    },
    "audienceLabel": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "people": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "branch"
  ],
  "additionalProperties": true
}
