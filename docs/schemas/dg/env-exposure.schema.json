{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PastaPastaPasta/dash-forge/master/docs/schemas/dg/env-exposure.schema.json",
  "title": "dg env exposure --json",
  "description": "Who could read each of an environment's current values: everyone a version holding the same value was saved for, from the versions you can open.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "env": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "readers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Identity ids, sorted."
          },
          "oldFormat": {
            "type": "boolean",
            "description": "A version saved in the old format held it too: anyone who held the members key could read it."
          }
        },
        "required": [
          "name",
          "readers",
          "oldFormat"
        ]
      }
    },
    "unopened": {
      "type": "integer",
      "description": "Versions of the environment you can't open; the people they were saved for are not counted."
    }
  },
  "required": [
    "schemaVersion",
    "env",
    "entries",
    "unopened"
  ],
  "additionalProperties": true
}
