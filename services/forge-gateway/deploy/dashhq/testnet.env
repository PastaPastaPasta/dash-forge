# dashhq's testnet gateway, https://testnet-git-forge.dashhq.org (deploy/dashhq/README.md). No secrets.
COMPOSE_PROJECT_NAME=forge-gateway-testnet
GATEWAY_IMAGE=ghcr.io/pastapastapasta/forge-gateway@sha256:f3cce9006e2a6db458cea1d9dd3c8a5cabef8097c5ee15a545b452348084e642
GATEWAY_HOST_PORT=18082
DASH_FORGE_NETWORK=testnet
GATEWAY_PUBLIC_URL=https://testnet-git-forge.dashhq.org
GATEWAY_WEB_URL=https://testnet-forge.dashhq.org
GATEWAY_ALL_PUBLIC=true
GATEWAY_TRUST_PROXY=cloudflare
GATEWAY_CACHE_MAX=10G
GATEWAY_DENY=/etc/forge-gateway/deny.txt
