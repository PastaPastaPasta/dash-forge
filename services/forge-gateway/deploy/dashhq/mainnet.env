# dashhq's mainnet gateway, https://git-forge.dashhq.org (deploy/dashhq/README.md). No secrets.
COMPOSE_PROJECT_NAME=forge-gateway-mainnet
GATEWAY_IMAGE=ghcr.io/pastapastapasta/forge-gateway@sha256:f3cce9006e2a6db458cea1d9dd3c8a5cabef8097c5ee15a545b452348084e642
GATEWAY_HOST_PORT=18081
DASH_FORGE_NETWORK=mainnet
GATEWAY_PUBLIC_URL=https://git-forge.dashhq.org
GATEWAY_WEB_URL=https://forge.dashhq.org
GATEWAY_ALL_PUBLIC=true
GATEWAY_TRUST_PROXY=cloudflare
GATEWAY_CACHE_MAX=15G
GATEWAY_DENY=/etc/forge-gateway/deny.txt
