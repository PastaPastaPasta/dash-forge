# dashhq's forge-gateways behind the Cloudflare proxy (deploy/dashhq/README.md).
# Imported from /etc/caddy/Caddyfile; touches no other site.
#
# The gateways read the client from CF-Connecting-IP (GATEWAY_TRUST_PROXY=cloudflare). A request
# that did not come from Cloudflare gets that header set to its real peer address, so nobody can
# pick their own rate-limit key by talking to the origin directly.
# Cloudflare's ranges: https://www.cloudflare.com/ips-v4 and /ips-v6 (2026-11-27).
(forge_gateway_client) {
	@not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	request_header @not_cloudflare CF-Connecting-IP {remote_host}
}

(forge_gateway) {
	import forge_gateway_client
	reverse_proxy 127.0.0.1:{args.0} {
		flush_interval -1
	}
}

# Mainnet took over git-forge.dashhq.org from testnet on 2026-11-27. A git request for a
# repository mainnet does not serve says where testnet repositories went.
(forge_gateway_mainnet) {
	import forge_gateway_client
	@git path_regexp repo ^/([^/]+)/([^/]+?)(?:\.git)?/(?:info/refs|git-upload-pack)$
	handle @git {
		reverse_proxy 127.0.0.1:{args.0} {
			flush_interval -1
			@absent status 404
			handle_response @absent {
				header X-Content-Type-Options nosniff
				respond 404 {
					body "no public repository {re.repo.1}/{re.repo.2} on mainnet. Testnet repositories moved to https://testnet-git-forge.dashhq.org/{re.repo.1}/{re.repo.2}.git"
				}
			}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:{args.0} {
			flush_interval -1
		}
	}
}

# deploy.sh appends one site block per network it enables, e.g.:
#   git-forge.dashhq.org {
#   	import forge_gateway_mainnet 18081
#   }
