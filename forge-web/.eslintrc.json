{
  "root": true,
  "extends": [
    "next/core-web-vitals",
    "plugin:@typescript-eslint/recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "project": "./tsconfig.json"
  },
  "plugins": ["@typescript-eslint"],
  "rules": {
    "no-console": "error",
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/ban-ts-comment": "error",
    "@typescript-eslint/no-unused-vars": ["error", {
      "argsIgnorePattern": "^_",
      "varsIgnorePattern": "^_"
    }]
  },
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "excludedFiles": ["**/*.test.ts", "**/*.test.tsx", "lib/private/testing.ts"],
      "rules": {
        "no-restricted-imports": ["error", {
          "paths": [
            {
              "name": "next/navigation",
              "importNames": ["usePathname", "useSearchParams"],
              "message": "Use hooks/use-route: it reads the page's route also while the address bar shows its short URL (CJ-6)."
            }
          ],
          "patterns": [
            {
              "group": ["**/private/testing", "**/private/testing.*"],
              "message": "lib/private/testing holds the deterministic (fixed nonce/fileId) seals for the conformance vectors: tests only (private-repos.md §3.6)."
            },
            {
              "group": ["**/private/doc", "**/private/pack", "**/private/release", "**/private/members-ref", "**/private/branch-key", "**/private/bot-post", "**/private/doc.*", "**/private/pack.*", "**/private/release.*", "**/private/members-ref.*", "**/private/branch-key.*", "**/private/bot-post.*"],
              "importNamePattern": "^__unsafe",
              "message": "__unsafe* seals take a caller-chosen nonce/fileId; only lib/private/testing.ts may import them."
            }
          ]
        }]
      }
    },
    {
      "files": ["lib/private/**/*.ts"],
      "excludedFiles": ["**/*.test.ts", "lib/private/testing.ts"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            {
              "group": ["./testing", "./testing.*", "**/private/testing", "**/private/testing.*"],
              "message": "lib/private/testing holds the deterministic (fixed nonce/fileId) seals for the conformance vectors: tests only (private-repos.md §3.6)."
            },
            {
              "group": ["./doc", "./pack", "./release", "./members-ref", "./branch-key", "./bot-post", "./doc.*", "./pack.*", "./release.*", "./members-ref.*", "./branch-key.*", "./bot-post.*", "**/private/doc", "**/private/pack", "**/private/release", "**/private/members-ref", "**/private/branch-key", "**/private/bot-post"],
              "importNamePattern": "^__unsafe",
              "message": "__unsafe* seals take a caller-chosen nonce/fileId; only lib/private/testing.ts may import them."
            }
          ]
        }]
      }
    },
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "excludedFiles": ["**/*.test.ts", "**/*.test.tsx", "lib/auth/wallet-sim.ts"],
      "rules": {
        "@typescript-eslint/no-restricted-imports": ["error", {
          "patterns": [
            {
              "group": ["**/vendor/platform-auth/app-connect/test-helpers", "**/vendor/platform-auth/app-connect/test-helpers.*", "./test-helpers", "./test-helpers.*"],
              "message": "The vendored App Connect test-helpers build vector requests from fixed seeds: tests and lib/auth/wallet-sim.ts only."
            }
          ]
        }]
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "out/",
    "*.config.js",
    "*.config.ts"
  ]
}
