{
  "name": "Dash Forge",
  "short_name": "Forge",
  "description": "A git forge with no server to trust: repositories, issues and pull requests on Dash Platform.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f0d0c",
