{
  "name": "forge-web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=22.18"
  },
  "browserslist": [
    "chrome >= 103",
    "edge >= 103",
    "firefox >= 104",
    "safari >= 16",
    "ios_saf >= 16"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/third-party-licenses.mjs out && node scripts/csp-hashes.mjs out && node scripts/build-manifest.mjs out",
    "build:ipfs": "FORGE_IPFS_BUILD=1 next build && node scripts/ipfs-postbuild.mjs out && node scripts/third-party-licenses.mjs out && node scripts/csp-hashes.mjs out && FORGE_IPFS_BUILD=1 node scripts/build-manifest.mjs out",
    "lint": "next lint",
    "lint:copy": "node scripts/copy-lint.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "vendor:status": "node ${PLATFORM_AUTH_DIR:-../../platform-auth}/tools/vendor.mjs status lib/vendor/platform-auth"
  },
  "dependencies": {
    "@dashevo/evo-sdk": "5.0.0-rc.8",
    "@dashevo/wasm-sdk": "5.0.0-rc.8",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@noble/secp256k1": "^3.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "js-yaml": "4.3.2",
    "lucide-react": "^0.577.0",
    "next": "14.2.35",
    "next-themes": "^0.4.6",
    "openpgp": "^6.3.2",
    "pako": "^3.0.2",
    "qr": "^0.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^4.6.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.17.0",
    "@types/pako": "^3.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
