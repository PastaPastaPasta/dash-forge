{
  "$formatVersion": "1",
  "id": "11111111111111111111111111111111",
  "ownerId": "11111111111111111111111111111111",
  "version": 1,
  "description": "Dash Forge v2 meta: repo keys, bans, labels, topics, pack mirrors, profiles, follows",
  "schemaDefs": {
    "id": {
      "type": "identifier"
    },
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "enc": {
      "type": "array",
      "byteArray": true,
      "minItems": 29,
      "maxItems": 1536
    },
    "hid": {
      "type": "identifier"
    }
  },
  "documentSchemas": {
    "repoKey": {
      "type": "object",
      "documentsMutable": false,
      "canBeDeleted": false,
      "ownerRefersTo": {
        "type": "deletableDocument",
        "documentType": "maintainer",
        "findBy": {
          "repoId": "repoId",
          "memberId": "."
        },
        "contractId": "FORGE_CORE_CONTRACT_ID"
      },
      "properties": {
        "repoId": {
          "$ref": "#/$defs/id",
          "position": 0
        },
        "memberId": {
          "type": "identifier",
          "refersTo": {
            "anyOf": [
              {
                "type": "deletableDocument",
                "contractId": "FORGE_CORE_CONTRACT_ID",
                "documentType": "maintainer",
                "findBy": {
                  "repoId": "repoId",
                  "memberId": "."
                }
              },
              {
                "type": "deletableDocument",
                "contractId": "FORGE_CORE_CONTRACT_ID",
                "documentType": "writer",
                "findBy": {
                  "repoId": "repoId",
                  "memberId": "."
                },
                "where": {
                  "role": "mr"
                }
              }
            ]
          },
          "position": 1
        },
        "epoch": {
          "$ref": "#/$defs/u32",
          "position": 2
        },
        "recipientKeyId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "position": 3,
          "refersTo": {
            "type": "identityPublicKey",
            "identityProperty": "memberId",
            "keyRequirements": {
              "purpose": "encryption"
            }
          }
        },
        "senderKeyId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "refersTo": {
            "type": "identityPublicKey",
            "identityProperty": "$ownerId",
            "keyRequirements": {
              "purpose": "encryption"
            }
          },
          "position": 4
        },
        "wrapped": {
          "type": "array",
          "byteArray": true,
          "minItems": 32,
          "maxItems": 96,
          "encryptedFor": {
            "recipient": "memberId",
            "recipientKey": "recipientKeyId",
            "senderKey": "senderKeyId",
            "scheme": "ecdh-secp256k1-aes256-cbc"
          },
          "position": 5
        },
        "mr": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "position": 6
        }
      },
      "indices": [
        {
          "name": "memberEpoch",
          "properties": [
            {
              "repoId": "asc"
            },
            {
              "memberId": "asc"
            },
            {
              "epoch": "asc"
            },
            {
              "$ownerId": "asc"
            }
          ],
          "unique": true
        },
        {
          "name": "byMember",
          "properties": [
            {
              "memberId": "asc"
            }
          ]
        }
      ],
      "required": [
        "$createdAt",
        "$createdAtBlockHeight",
        "repoId",
        "memberId",
        "epoch",
        "recipientKeyId",
        "senderKeyId",
        "wrapped",
        "mr"
      ],
      "additionalProperties": false,
      "propertyConstraints": {
        "mrClaim": {
          "in": [
            "mr",
            [
              1,
              2,
              3
            ]
          ]
        }
      }
    },
    "ban": {
      "type": "object",
      "documentsMutable": false,
      "canBeDeleted": true,
      "ownerRefersTo": {
        "type": "deletableDocument",
        "contractId": "FORGE_CORE_CONTRACT_ID",
        "documentType": "maintainer",
        "findBy": {
          "repoId": "repoId",
          "memberId": "."
        }
      },
      "properties": {
        "repoId": {
          "type": "identifier",
          "position": 0
        },
        "identityId": {
          "type": "identifier",
          "position": 1
        },
        "reason": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "position": 2
        }
      },
      "indices": [
        {
          "name": "byRepo",
          "properties": [
            {
              "repoId": "asc"
            },
            {
              "identityId": "asc"
            },
            {
              "$ownerId": "asc"
            }
          ],
          "unique": true
        }
      ],
      "required": [
        "$createdAt",
        "repoId",
        "identityId"
      ],
      "additionalProperties": false
    },
    "label": {
      "type": "object",
      "documentsMutable": false,
      "canBeDeleted": true,
      "ownerRefersTo": {
        "anyOf": [
          {
            "type": "deletableDocument",
            "documentType": "maintainer",
            "findBy": {
              "repoId": "repoId",
              "memberId": "."
            },
            "contractId": "FORGE_CORE_CONTRACT_ID"
          },
          {
            "type": "deletableDocument",
            "documentType": "writer",
            "findBy": {
              "repoId": "repoId",
              "memberId": "."
            },
            "where": {
              "role": "r"
            },
            "contractId": "FORGE_CORE_CONTRACT_ID"
          }
        ]
      },
      "properties": {
        "repoId": {
          "$ref": "#/$defs/id",
          "position": 0
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "maxBytes": 60,
          "position": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]([^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$"
        },
        "color": {
          "type": "string",
          "maxLength": 7,
          "pattern": "^#[0-9a-fA-F]{6}$",
          "position": 2
        },
        "description": {
          "type": "string",
          "maxLength": 200,
          "maxBytes": 400,
          "position": 3
        },
        "retired": {
          "type": "boolean",
          "position": 4
        },
        "enc": {
          "$ref": "#/$defs/enc",
          "position": 5
        },
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "position": 6
        },
        "r": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2,
          "position": 7
        }
      },
      "indices": [
        {
          "name": "name",
          "properties": [
            {
              "repoId": "asc"
            },
            {
              "name": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ]
        }
      ],
      "required": [
        "$createdAt",
        "repoId",
        "name",
        "r"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "enc": [
          "epoch"
        ]
      },
      "propertyConstraints": {
        "noPlain": {
          "anyOf": [
            {
              "absent": "enc"
            },
            {
              "allOf": [
                {
                  "absent": "color"
                },
                {
                  "absent": "description"
                }
              ]
            }
          ]
        },
        "rClaim": {
          "in": [
            "r",
            [
              1,
              2
            ]
          ]
        }
      }
    },
    "topic": {
      "type": "object",
      "documentsMutable": false,
      "canBeDeleted": true,
      "properties": {
        "repoId": {
          "type": "identifier",
          "refersTo": {
            "type": "permanentDocument",
            "documentType": "repo",
            "where": {
              "$ownerId": "$ownerId",
              "visibility": {
                "const": "public"
              }
            },
            "contractId": "FORGE_CORE_CONTRACT_ID"
          },
          "position": 0
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "maxBytes": 30,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "position": 1
        }
      },
      "indices": [
        {
          "name": "byRepo",
          "properties": [
            {
              "repoId": "asc"
            },
            {
              "name": "asc"
            }
          ],
          "unique": true
        },
        {
          "name": "byName",
          "properties": [
            {
              "name": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ],
          "rangeCountable": true,
          "rankedCountable": {
            "at": "name"
          }
        },
        {
          "name": "perRepo",
          "properties": [
            {
              "repoId": "asc"
            }
          ],
          "countable": true
        }
      ],
      "required": [
        "$createdAt",
        "repoId",
        "name"
      ],
      "additionalProperties": false,
      "propertyConstraints": {
        "atMost20": {
          "lessThanOrEqual": [
            {
              "countOf": [
                "topic",
                {
                  "repoId": "repoId"
                }
              ]
            },
            20
          ]
        }
      }
    },
    "packMirror": {
      "type": "object",
      "documentsMutable": false,
      "canBeDeleted": true,
      "properties": {
        "repoId": {
          "type": "identifier",
          "refersTo": {
            "type": "permanentDocument",
            "documentType": "repo",
            "where": {
              "visibility": {
                "const": "public"
              }
            },
            "contractId": "FORGE_CORE_CONTRACT_ID"
          },
          "position": 0
        },
        "packHash": {
          "$ref": "#/$defs/hid",
          "position": 1
        },
        "kind": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255,
          "position": 2
        },
        "uris": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^(https://[^[:space:]/?#@]+|ipfs://[A-Za-z0-9]+)([/?#][^[:space:]]*)?$"
          },
          "position": 3
        }
      },
      "indices": [
        {
          "name": "byHash",
          "properties": [
            {
              "repoId": "asc"
            },
            {
              "packHash": "asc"
            },
            {
              "$ownerId": "asc"
            }
          ],
          "unique": true
        },
        {
          "name": "byOwner",
          "properties": [
            {
              "$ownerId": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ]
        }
      ],
      "required": [
        "$createdAt",
        "repoId",
        "packHash",
        "kind",
        "uris"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "maxLength": 60,
          "maxBytes": 240,
          "position": 0
        },
        "bio": {
          "type": "string",
          "maxLength": 500,
          "maxBytes": 1000,
          "position": 1
        },
        "avatarConfig": {
          "type": "string",
          "maxLength": 200,
          "maxBytes": 200,
          "position": 2
        },
        "links": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^https://[^[:space:]/?#@]+([/?#][^[:space:]]*)?$"
          },
          "position": 3
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "maxBytes": 240,
          "position": 4
        },
        "company": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "maxBytes": 240,
          "position": 5
        },
        "pubkeys": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "maxBytes": 300
          },
          "position": 6
        },
        "keyProofs": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 1200,
            "pattern": "^[A-Za-z0-9+/]*={0,2}$"
          },
          "position": 7
        },
        "bot": {
          "type": "object",
          "properties": {
            "operator": {
              "type": "identifier",
              "position": 0
            },
            "operates": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "identifier"
              },
              "position": 1
            }
          },
          "additionalProperties": false,
          "position": 8
        }
      },
      "indices": [
        {
          "name": "owner",
          "properties": [
            {
              "$ownerId": "asc"
            }
          ],
          "unique": true
        }
      ],
      "additionalProperties": false
    },
    "follow": {
      "type": "object",
      "documentsMutable": false,
      "indexOnly": true,
      "properties": {
        "identityId": {
          "type": "identifier",
          "distinctFrom": "$ownerId",
          "refersTo": {
            "type": "identity"
          },
          "position": 0
        }
      },
      "indices": [
        {
          "name": "byTarget",
          "properties": [
            {
              "identityId": "asc"
            }
          ],
          "rangeCountable": true,
          "rankedCountable": true
        },
        {
          "name": "byOwner",
          "properties": [
            {
              "$ownerId": "asc"
            }
          ],
          "terminal": "identityId",
          "countable": "countable"
        }
      ],
      "required": [
        "identityId"
      ],
      "additionalProperties": false
    },
    "vaultEntry": {
      "type": "object",
      "documentsMutable": true,
      "canBeDeleted": true,
      "properties": {
        "credentialId": {
          "type": "array",
          "byteArray": true,
          "minItems": 16,
          "maxItems": 255,
          "position": 0
        },
        "recipientKey": {
          "type": "bytes",
          "size": 32,
          "position": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255,
          "position": 2
        },
        "authKeyId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "position": 3,
          "refersTo": {
            "type": "identityPublicKey",
            "identityProperty": "$ownerId",
            "keyRequirements": {
              "purpose": "authentication"
            }
          }
        },
        "enc": {
          "type": "bytes",
          "size": 32,
          "position": 4
        },
        "sealed": {
          "type": "array",
          "byteArray": true,
          "minItems": 32,
          "maxItems": 256,
          "position": 5
        }
      },
      "immutable": [
        "credentialId",
        "recipientKey"
      ],
      "indices": [
        {
          "name": "byCredential",
          "properties": [
            {
              "$ownerId": "asc"
            },
            {
              "credentialId": "asc"
            }
          ],
          "unique": true
        }
      ],
      "required": [
        "$createdAt",
        "$updatedAt",
        "credentialId",
        "recipientKey",
        "version",
        "authKeyId",
        "enc",
        "sealed"
      ],
      "additionalProperties": false
    }
  },
  "config": {
    "$formatVersion": "2",
    "canBeDeleted": false,
    "readonly": false,
    "keepsHistory": false,
    "documentsKeepHistoryContractDefault": false,
    "documentsMutableContractDefault": true,
    "documentsCanBeDeletedContractDefault": true,
    "sizedIntegerTypes": true
  }
}
