{
  "$formatVersion": "1",
  "id": "11111111111111111111111111111111",
  "ownerId": "11111111111111111111111111111111",
  "version": 1,
  "description": "Dash Forge v2 community: events, milestones, runners, check runs, policies, stars, webhooks",
  "schemaDefs": {
    "id": {
      "type": "array",
      "byteArray": true,
      "minItems": 32,
      "maxItems": 32,
      "contentMediaType": "application/x.dash.dpp.identifier"
    },
    "oid": {
      "type": "array",
      "byteArray": true,
      "minItems": 20,
      "maxItems": 32
    },
    "h32": {
      "type": "array",
      "byteArray": true,
      "minItems": 32,
      "maxItems": 32
    },
    "num": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "enc": {
      "type": "array",
      "byteArray": true,
      "minItems": 29,
      "maxItems": 5120
    },
    "vis": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ]
    }
  },
  "documentSchemas": {
    "profile": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "maxLength": 60,
          "maxBytes": 240,
          "position": 0
        },
        "bio": {
          "type": "string",
          "maxLength": 500,
          "maxBytes": 1000,
          "position": 1
        },
        "avatarConfig": {
          "type": "string",
          "maxLength": 200,
          "maxBytes": 200,
          "position": 2
        },
        "links": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^https://[^[:space:]/?#@]+([/?#][^[:space:]]*)?$"
          },
          "position": 3
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "maxBytes": 240,
          "position": 4
        },
        "company": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "maxBytes": 240,
          "position": 5
        },
        "pubkeys": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "maxBytes": 300
          },
          "position": 6
        },
        "keyProofs": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 1200,
            "pattern": "^[A-Za-z0-9+/]*={0,2}$"
          },
          "position": 7
        },
        "bot": {
          "type": "object",
          "properties": {
            "operator": {
              "type": "array",
              "byteArray": true,
              "minItems": 32,
              "maxItems": 32,
              "contentMediaType": "application/x.dash.dpp.identifier",
              "position": 0
            },
            "operates": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "array",
                "byteArray": true,
                "minItems": 32,
                "maxItems": 32,
                "contentMediaType": "application/x.dash.dpp.identifier"
              },
              "position": 1
            }
          },
          "additionalProperties": false,
          "position": 8
        }
      },
      "indices": [
        {
          "name": "owner",
          "properties": [
            {
              "$ownerId": "asc"
            }
          ],
          "unique": true
        }
      ],
      "additionalProperties": false
    },
    "star": {
      "type": "object",
      "documentsMutable": false,
      "indexOnly": true,
      "properties": {
        "repoId": {
          "type": "array",
          "byteArray": true,
          "minItems": 32,
          "maxItems": 32,
          "contentMediaType": "application/x.dash.dpp.identifier",
          "refersTo": {
            "type": "permanentDocument",
            "contractId": "FORGE_CORE_CONTRACT_ID",
            "documentType": "repo"
          },
          "position": 0
        }
      },
      "indices": [
        {
          "name": "byRepo",
          "properties": [
            {
              "repoId": "asc"
            }
          ],
          "rangeCountable": true,
          "rankedCountable": true
        },
        {
          "name": "byOwner",
          "properties": [
            {
              "$ownerId": "asc"
            }
          ],
          "terminal": "repoId",
          "countable": true
        },
        {
          "name": "byWeek",
          "properties": [
            {
              "$createdAt": "asc"
            },
            {
              "repoId": "asc"
            }
          ],
          "timeRange": {
            "on": "$createdAt",
            "range": 604800,
            "step": 86400,
            "ttl": 604800
          },
          "rangeCountable": true,
          "rankedCountable": true,
          "outlivesDelete": true
        }
      ],
      "required": [
        "repoId",
        "$createdAt"
      ],
      "additionalProperties": false
    },
    "watch": {
      "type": "object",
      "documentsMutable": false,
      "indexOnly": true,
      "properties": {
        "repoId": {
          "type": "array",
          "byteArray": true,
          "minItems": 32,
          "maxItems": 32,
          "contentMediaType": "application/x.dash.dpp.identifier",
          "refersTo": {
            "type": "permanentDocument",
            "contractId": "FORGE_CORE_CONTRACT_ID",
            "documentType": "repo"
          },
          "position": 0
        }
      },
      "indices": [
        {
          "name": "byRepo",
          "properties": [
            {
              "repoId": "asc"
            }
          ],
          "rangeCountable": true,
          "rankedCountable": true
        },
        {
          "name": "byOwner",
          "properties": [
            {
              "$ownerId": "asc"
            }
          ],
          "terminal": "repoId",
          "countable": true
        }
      ],
      "required": [
        "repoId"
      ],
      "additionalProperties": false
    },
    "follow": {
      "type": "object",
      "documentsMutable": false,
      "indexOnly": true,
      "properties": {
        "identityId": {
          "type": "array",
          "byteArray": true,
          "minItems": 32,
          "maxItems": 32,
          "contentMediaType": "application/x.dash.dpp.identifier",
          "distinctFrom": "$ownerId",
          "refersTo": {
            "type": "identity"
          },
          "position": 0
        }
      },
      "indices": [
        {
          "name": "byTarget",
          "properties": [
            {
              "identityId": "asc"
            }
          ],
          "rangeCountable": true,
          "rankedCountable": true
        },
        {
          "name": "byOwner",
          "properties": [
            {
              "$ownerId": "asc"
            }
          ],
          "terminal": "identityId",
          "countable": "countable"
        }
      ],
      "required": [
        "identityId"
      ],
      "additionalProperties": false
    },
    "webhook": {
      "type": "object",
      "immutable": [
        "repoId",
        "hookId"
      ],
      "ownerRefersTo": {
        "type": "deletableDocument",
        "contractId": "FORGE_CORE_CONTRACT_ID",
        "documentType": "maintainer",
        "findBy": {
          "repoId": "repoId",
          "memberId": "."
        },
        "where": {
          "vis": "vis"
        }
      },
      "properties": {
        "repoId": {
          "$ref": "#/$defs/id",
          "position": 0
        },
        "hookId": {
          "$ref": "#/$defs/h32",
          "position": 1
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "maxBytes": 300,
          "position": 2,
          "pattern": "^https://([A-Za-z0-9-]+[.])+[A-Za-z][A-Za-z0-9-]*[A-Za-z0-9](:[0-9]{1,5})?([/?#][^[:space:]]*)?$"
        },
        "events": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "position": 3
        },
        "relayIdentityId": {
          "type": "array",
          "byteArray": true,
          "minItems": 32,
          "maxItems": 32,
          "contentMediaType": "application/x.dash.dpp.identifier",
          "refersTo": {
            "type": "identityPublicKey",
            "keyIdProperty": "relayKeyId",
            "keyRequirements": {
              "purpose": "encryption"
            }
          },
          "position": 4
        },
        "relayKeyId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "position": 5
        },
        "senderKeyId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "refersTo": {
            "type": "identityPublicKey",
            "identityProperty": "$ownerId",
            "keyRequirements": {
              "purpose": "encryption"
            }
          },
          "position": 6
        },
        "secret": {
          "type": "array",
          "byteArray": true,
          "minItems": 32,
          "maxItems": 128,
          "encryptedFor": {
            "recipient": "relayIdentityId",
            "recipientKey": "relayKeyId",
            "senderKey": "senderKeyId",
            "scheme": "ecdh-secp256k1-aes256-cbc"
          },
          "position": 7
        },
        "disabled": {
          "type": "boolean",
          "position": 8
        },
        "vis": {
          "$ref": "#/$defs/vis",
          "position": 9
        }
      },
      "indices": [
        {
          "name": "hook",
          "properties": [
            {
              "repoId": "asc"
            },
            {
              "hookId": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ]
        },
        {
          "name": "list",
          "properties": [
            {
              "repoId": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ]
        },
        {
          "name": "relay",
          "properties": [
            {
              "relayIdentityId": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ]
        }
      ],
      "required": [
        "$createdAt",
        "repoId",
        "hookId",
        "url",
        "relayIdentityId",
        "relayKeyId",
        "senderKeyId",
        "secret",
        "vis"
      ],
      "additionalProperties": false,
      "propertyConstraints": {
        "publicOnly": {
          "equal": [
            "vis",
            {
              "const": "public"
            }
          ]
        }
      }
    },
    "checkRun": {
      "type": "object",
      "immutable": [
        "repoId",
        "headOid",
        "name",
        "vis",
        {
          "property": "startedAt",
          "when": {
            "present": "$old.startedAt"
          }
        },
        {
          "property": "completedAt",
          "when": {
            "present": "$old.completedAt"
          }
        },
        {
          "property": "conclusion",
          "when": {
            "present": "$old.conclusion"
          }
        },
        {
          "property": "externalId",
          "when": {
            "present": "$old.externalId"
          }
        },
        {
          "property": "summary",
          "when": {
            "equal": [
              "$old.status",
              {
                "const": "completed"
              }
            ]
          }
        },
        {
          "property": "detailsUrl",
          "when": {
            "equal": [
              "$old.status",
              {
                "const": "completed"
              }
            ]
          }
        },
        {
          "property": "logUrl",
          "when": {
            "equal": [
              "$old.status",
              {
                "const": "completed"
              }
            ]
          }
        },
        {
          "property": "logSha256",
          "when": {
            "equal": [
              "$old.status",
              {
                "const": "completed"
              }
            ]
          }
        },
        {
          "property": "artifacts",
          "when": {
            "equal": [
              "$old.status",
              {
                "const": "completed"
              }
            ]
          }
        }
      ],
      "ownerRefersTo": {
        "anyOf": [
          {
            "type": "deletableDocument",
            "documentType": "runner",
            "findBy": {
              "repoId": "repoId",
              "memberId": "."
            }
          },
          {
            "type": "deletableDocument",
            "contractId": "FORGE_CORE_CONTRACT_ID",
            "documentType": "maintainer",
            "findBy": {
              "repoId": "repoId",
              "memberId": "."
            }
          },
          {
            "type": "deletableDocument",
            "contractId": "FORGE_CORE_CONTRACT_ID",
            "documentType": "writer",
            "findBy": {
              "repoId": "repoId",
              "memberId": "."
            },
            "where": {
              "role": "r"
            }
          }
        ]
      },
      "properties": {
        "repoId": {
          "type": "array",
          "byteArray": true,
          "minItems": 32,
          "maxItems": 32,
          "contentMediaType": "application/x.dash.dpp.identifier",
          "refersTo": {
            "type": "permanentDocument",
            "contractId": "FORGE_CORE_CONTRACT_ID",
            "documentType": "repo",
            "where": {
              "visibility": "vis"
            }
          },
          "position": 0
        },
        "headOid": {
          "$ref": "#/$defs/oid",
          "position": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "maxBytes": 200,
          "position": 2
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "in_progress",
            "completed"
          ],
          "position": 3
        },
        "conclusion": {
          "type": "string",
          "enum": [
            "success",
            "failure",
            "neutral",
            "cancelled",
            "skipped",
            "timed_out",
            "action_required",
            "stale"
          ],
          "position": 4
        },
        "detailsUrl": {
          "type": "string",
          "maxLength": 300,
          "maxBytes": 300,
          "minLength": 1,
          "position": 5,
          "pattern": "^https://[^[:space:]/?#@]+([/?#][^[:space:]]*)?$"
        },
        "summary": {
          "type": "string",
          "maxLength": 1000,
          "maxBytes": 2000,
          "minLength": 1,
          "position": 6
        },
        "externalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "maxBytes": 120,
          "position": 7
        },
        "startedAt": {
          "type": "integer",
          "minimum": 0,
          "position": 8
        },
        "completedAt": {
          "type": "integer",
          "minimum": 0,
          "position": 9
        },
        "artifacts": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "maxBytes": 4096,
          "position": 10
        },
        "logUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "maxBytes": 300,
          "position": 11,
          "pattern": "^(https://[^[:space:]/?#@]+|ipfs://[A-Za-z0-9]+)([/?#][^[:space:]]*)?$"
        },
        "logSha256": {
          "type": "array",
          "byteArray": true,
          "minItems": 32,
          "maxItems": 32,
          "position": 12
        },
        "outcome": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "position": 13
        },
        "vis": {
          "$ref": "#/$defs/vis",
          "position": 14
        },
        "r": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1,
          "position": 15
        }
      },
      "indices": [
        {
          "name": "head",
          "properties": [
            {
              "repoId": "asc"
            },
            {
              "headOid": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ]
        },
        {
          "name": "recent",
          "properties": [
            {
              "repoId": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ]
        },
        {
          "name": "updated",
          "properties": [
            {
              "repoId": "asc"
            },
            {
              "$updatedAt": "asc"
            }
          ]
        },
        {
          "name": "outcome",
          "properties": [
            {
              "repoId": "asc"
            },
            {
              "headOid": "asc"
            },
            {
              "outcome": "asc"
            }
          ],
          "rangeCountable": true
        }
      ],
      "required": [
        "$createdAt",
        "$updatedAt",
        "repoId",
        "headOid",
        "name",
        "status",
        "outcome",
        "vis",
        "r"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "logUrl": [
          "logSha256"
        ],
        "logSha256": [
          "logUrl"
        ]
      },
      "propertyConstraints": {
        "conclusionIfDone": {
          "anyOf": [
            {
              "notEqual": [
                "status",
                {
                  "const": "completed"
                }
              ]
            },
            {
              "present": "conclusion"
            }
          ]
        },
        "doneIfConclusion": {
          "anyOf": [
            {
              "equal": [
                "status",
                {
                  "const": "completed"
                }
              ]
            },
            {
              "absent": "conclusion"
            }
          ]
        },
        "startedIfRunning": {
          "anyOf": [
            {
              "equal": [
                "status",
                {
                  "const": "queued"
                }
              ]
            },
            {
              "present": "startedAt"
            }
          ]
        },
        "runningIfStarted": {
          "anyOf": [
            {
              "absent": "startedAt"
            },
            {
              "notEqual": [
                "status",
                {
                  "const": "queued"
                }
              ]
            }
          ]
        },
        "completedAtIfDone": {
          "anyOf": [
            {
              "notEqual": [
                "status",
                {
                  "const": "completed"
                }
              ]
            },
            {
              "present": "completedAt"
            }
          ]
        },
        "doneIfCompletedAt": {
          "anyOf": [
            {
              "absent": "completedAt"
            },
            {
              "equal": [
                "status",
                {
                  "const": "completed"
                }
              ]
            }
          ]
        },
        "doneAfterStart": {
          "anyOf": [
            {
              "absent": "completedAt"
            },
            {
              "greaterThanOrEqual": [
                "completedAt",
                "startedAt"
              ]
            }
          ]
        },
        "msEpoch": {
          "anyOf": [
            {
              "absent": "startedAt"
            },
            {
              "greaterThanOrEqual": [
                "startedAt",
                1000000000000
              ]
            }
          ]
        },
        "notFuture": {
          "lessThanOrEqual": [
            {
              "max": [
                {
                  "ifAbsent": [
                    "startedAt",
                    0
                  ]
                },
                {
                  "ifAbsent": [
                    "completedAt",
                    0
                  ]
                }
              ]
            },
            {
              "add": [
                "$updatedAt",
                3600000
              ]
            }
          ]
        },
        "oidWidth": {
          "in": [
            {
              "count": "headOid"
            },
            [
              20,
              32
            ]
          ]
        },
        "outcomeOf": {
          "ifThenElse": [
            {
              "notEqual": [
                "status",
                {
                  "const": "completed"
                }
              ]
            },
            {
              "equal": [
                "outcome",
                0
              ]
            },
            {
              "ifThenElse": [
                {
                  "in": [
                    "conclusion",
                    [
                      "success",
                      "neutral",
                      "skipped"
                    ]
                  ]
                },
                {
                  "equal": [
                    "outcome",
                    1
                  ]
                },
                {
                  "equal": [
                    "outcome",
                    2
                  ]
                }
              ]
            }
          ]
        },
        "privateNoText": {
          "anyOf": [
            {
              "notEqual": [
                "vis",
                {
                  "const": "private"
                }
              ]
            },
            {
              "allOf": [
                {
                  "absent": "summary"
                },
                {
                  "absent": "detailsUrl"
                },
                {
                  "absent": "logUrl"
                },
                {
                  "absent": "artifacts"
                },
                {
                  "absent": "externalId"
                }
              ]
            }
          ]
        }
      }
    },
    "policy": {
      "type": "object",
      "documentsMutable": false,
      "canBeDeleted": false,
      "ownerRefersTo": {
        "type": "deletableDocument",
        "contractId": "FORGE_CORE_CONTRACT_ID",
        "documentType": "maintainer",
        "findBy": {
          "repoId": "repoId",
          "memberId": "."
        }
      },
      "properties": {
        "repoId": {
          "$ref": "#/$defs/id",
          "position": 0
        },
        "requiredApprovals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "position": 1
        },
        "approverRole": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1,
          "position": 2
        },
        "requireChecks": {
          "type": "boolean",
          "position": 3
        },
        "mergeMethods": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15,
          "position": 4
        },
        "requiredChecks": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "maxBytes": 200
          },
          "position": 5
        },
        "requiredCheckSources": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "array",
            "byteArray": true,
            "minItems": 32,
            "maxItems": 32,
            "contentMediaType": "application/x.dash.dpp.identifier",
            "refersTo": {
              "anyOf": [
                {
                  "type": "deletableDocument",
                  "documentType": "runner",
                  "findBy": {
                    "repoId": "repoId",
                    "memberId": "."
                  }
                },
                {
                  "type": "deletableDocument",
                  "contractId": "FORGE_CORE_CONTRACT_ID",
                  "documentType": "maintainer",
                  "findBy": {
                    "repoId": "repoId",
                    "memberId": "."
                  }
                }
              ]
            }
          },
          "position": 6
        },
        "requireCodeOwners": {
          "type": "boolean",
          "position": 7
        }
      },
      "indices": [
        {
          "name": "created",
          "properties": [
            {
              "repoId": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ]
        }
      ],
      "required": [
        "$createdAt",
