        "reporter": "writ",
        "createdAt": 100,
        "conclusion": "failure"
      },
      {
        "id": "r2",
        "headOid": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "name": "build",
        "status": "completed",
        "reporter": "gone",
        "createdAt": 200,
        "conclusion": "success"
      }
    ],
    "headOid": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "memberships": [
      {
        "identity": "maint",
        "role": "maintainer",
        "createdAt": 10
      },
      {
        "identity": "writ",
        "role": "writer",
        "createdAt": 10
      }
    ],
    "policy": {
      "requiredChecks": [
        "build"
      ]
    }
  },
  "expected": {
    "required": [
      {
        "name": "build",
