    "listed": [
      "abababababababababababababababababababababababababababababababab"
    ],
    "visibility": "public",
    "mirrors": [
      {
        "id": "m1",
        "ownerRole": "maintainer",
        "createdAt": 1,
        "packHash": "abababababababababababababababababababababababababababababababab",
        "kind": 1,
        "uris": [
          "ipfs://bafyabc",
          "https://maint.example/p"
        ]
      },
      {
        "id": "w1",
        "ownerRole": "writer",
        "createdAt": 2,
        "packHash": "abababababababababababababababababababababababababababababababab",
        "kind": 2,
        "uris": [
          "https://writer.example/p",
          "ipfs://bafydef/x",
          "ipfs://bafyghi"
