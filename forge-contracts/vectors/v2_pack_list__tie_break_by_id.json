{
  "name": "tie_break_by_id",
  "description": "Two packs uploaded at the same time are positioned by document $id.",
  "case": "v2_pack_list",
  "rules": "v2",
  "input": {
    "copies": [
      {
        "id": "zz",
        "packHash": "P1",
        "kind": 0,
        "createdAt": 10,
        "sizeBytes": 100,
        "objectCount": 5,
        "chunkCount": 1,
        "ownerRole": "writer"
      },
      {
        "id": "aa",
        "packHash": "P2",
        "kind": 0,
        "createdAt": 10,
        "sizeBytes": 100,
        "objectCount": 5,
        "chunkCount": 1,
        "ownerRole": "writer"
      }
    ]
  },
  "expected": [
    {
      "packRef": 0,
      "packHash": "P2",
      "kind": 0,
      "sizeBytes": 100,
      "objectCount": 5,
      "chunkCount": 1,
      "supersedes": [],
      "first": {
        "createdAt": 10,
        "id": "aa"
      },
      "copies": [
        "aa"
      ],
      "superseded": false
    },
    {
      "packRef": 1,
      "packHash": "P1",
      "kind": 0,
      "sizeBytes": 100,
      "objectCount": 5,
      "chunkCount": 1,
      "supersedes": [],
      "first": {
        "createdAt": 10,
        "id": "zz"
      },
      "copies": [
        "zz"
      ],
      "superseded": false
    }
  ]
}
