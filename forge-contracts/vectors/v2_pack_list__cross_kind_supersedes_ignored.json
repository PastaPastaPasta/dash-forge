{
  "name": "cross_kind_supersedes_ignored",
  "description": "A verified kind-1 pack (L1) names git pack P1 in supersedes and a verified kind-0 pack (C1) names P2: a manifest supersedes only packs of its own kind, so P1 stays unsuperseded and P2 is superseded.",
  "case": "v2_pack_list",
  "rules": "v2",
  "input": {
    "copies": [
      {
        "id": "a",
        "packHash": "P1",
        "kind": 0,
        "createdAt": 10,
        "sizeBytes": 100,
        "objectCount": 5,
        "chunkCount": 1,
        "ownerRole": "writer",
        "verified": true
      },
      {
        "id": "b",
        "packHash": "P2",
        "kind": 0,
        "createdAt": 20,
        "sizeBytes": 100,
        "objectCount": 5,
        "chunkCount": 1,
        "ownerRole": "writer",
        "verified": true
      },
      {
        "id": "c",
        "packHash": "C1",
        "kind": 0,
        "createdAt": 30,
        "sizeBytes": 100,
        "objectCount": 5,
        "chunkCount": 1,
        "ownerRole": "maintainer",
        "verified": true,
        "supersedes": [
          "P2"
        ]
      },
      {
        "id": "l",
        "packHash": "L1",
        "kind": 1,
        "createdAt": 40,
        "sizeBytes": 100,
        "objectCount": 5,
        "chunkCount": 1,
        "ownerRole": "writer",
        "verified": true,
        "supersedes": [
          "P1"
        ]
      }
    ]
  },
  "expected": [
    {
      "packRef": 0,
      "packHash": "P1",
      "kind": 0,
      "sizeBytes": 100,
      "objectCount": 5,
      "chunkCount": 1,
      "supersedes": [],
      "first": {
        "createdAt": 10,
        "id": "a"
      },
      "copies": [
        "a"
      ],
      "superseded": false
    },
    {
      "packRef": 1,
      "packHash": "P2",
      "kind": 0,
      "sizeBytes": 100,
      "objectCount": 5,
      "chunkCount": 1,
      "supersedes": [],
      "first": {
        "createdAt": 20,
        "id": "b"
      },
      "copies": [
        "b"
      ],
      "superseded": true
    },
    {
      "packRef": 2,
      "packHash": "C1",
      "kind": 0,
      "sizeBytes": 100,
      "objectCount": 5,
      "chunkCount": 1,
      "supersedes": [
        "P2"
      ],
      "first": {
        "createdAt": 30,
        "id": "c"
      },
      "copies": [
        "c"
      ],
      "superseded": false
    },
    {
      "packRef": 0,
      "packHash": "L1",
      "kind": 1,
      "sizeBytes": 100,
      "objectCount": 5,
      "chunkCount": 1,
      "supersedes": [
        "P1"
      ],
      "first": {
        "createdAt": 40,
        "id": "l"
      },
      "copies": [
        "l"
      ],
      "superseded": false
    }
  ]
}
