{
  "name": "maintainer_outranks_triage",
  "description": "A triage writer document from 10 and a maintainer document from 20: from 20 the identity is a maintainer and an approver.",
  "case": "role_oracle",
  "rules": "v2",
  "input": {
    "memberships": [
      {
        "identity": "x",
        "role": "triage",
        "createdAt": 10
      },
      {
        "identity": "x",
        "role": "maintainer",
        "createdAt": 20
      }
    ],
    "queries": [
      {
        "identity": "x",
        "at": 15
      },
      {
        "identity": "x",
        "at": 20
      }
    ]
  },
  "expected": [
    {
      "roleAt": "triage",
      "memberAt": true,
      "currentRole": "maintainer",
      "approverAt": false
    },
    {
      "roleAt": "maintainer",
      "memberAt": true,
      "currentRole": "maintainer",
      "approverAt": true
    }
  ]
}
