      {
        "id": "r2",
        "reviewer": "alice",
        "verdict": 2,
        "commitOid": "H",
        "createdAt": 110
      }
    ],
    "memberships": [
      {
        "identity": "alice",
        "role": "maintainer",
        "createdAt": 10
      },
      {
        "identity": "maint",
        "role": "maintainer",
        "createdAt": 10
      }
    ],
    "headOid": "H",
