{
  "name": "self_supersede_ignored",
  "description": "A pack listing its own hash in supersedes does not mark itself superseded.",
  "case": "pack_copies",
  "rules": "v2",
  "input": {
    "copies": [
      {
        "id": "c1",
        "packHash": "P1",
        "ownerRole": "maintainer",
        "createdAt": 10,
        "verified": true,
        "supersedes": [
          "P1"
        ]
      }
    ]
  },
  "expected": {
    "readOrder": [
      {
        "packHash": "P1",
        "copyId": "c1",
        "superseded": false
      }
    ]
  }
}
