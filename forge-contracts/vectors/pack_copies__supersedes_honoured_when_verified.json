{
  "name": "supersedes_honoured_when_verified",
  "description": "A verified consolidated pack that supersedes P1 is read first; P1 stays readable after it as a fallback.",
  "case": "pack_copies",
  "rules": "v2",
  "input": {
    "copies": [
      {
        "id": "c1",
        "packHash": "P1",
        "ownerRole": "writer",
        "createdAt": 10,
        "verified": true
      },
      {
        "id": "c2",
        "packHash": "P2",
        "ownerRole": "maintainer",
        "createdAt": 20,
        "verified": true,
        "supersedes": [
          "P1"
        ]
      }
    ]
  },
  "expected": {
    "readOrder": [
      {
        "packHash": "P2",
        "copyId": "c2",
        "superseded": false
      },
      {
        "packHash": "P1",
        "copyId": "c1",
        "superseded": true
      }
    ]
  }
}
