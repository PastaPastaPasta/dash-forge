{
  "name": "supersedes_chain",
  "description": "P3 supersedes P2 and P2 supersedes P1: P3 is read first, then P1 and P2 as fallbacks (both superseded), by createdAt.",
  "case": "pack_copies",
  "rules": "v2",
  "input": {
    "copies": [
      {
        "id": "c1",
        "packHash": "P1",
        "ownerRole": "writer",
        "createdAt": 10,
        "verified": true
      },
      {
        "id": "c2",
        "packHash": "P2",
        "ownerRole": "writer",
        "createdAt": 20,
        "verified": true,
        "supersedes": [
          "P1"
        ]
      },
      {
        "id": "c3",
        "packHash": "P3",
        "ownerRole": "maintainer",
        "createdAt": 30,
        "verified": true,
        "supersedes": [
          "P2"
        ]
      }
    ]
  },
  "expected": {
    "readOrder": [
      {
        "packHash": "P3",
        "copyId": "c3",
        "superseded": false
      },
      {
        "packHash": "P1",
        "copyId": "c1",
        "superseded": true
      },
      {
        "packHash": "P2",
        "copyId": "c2",
        "superseded": true
      }
    ]
  }
}
