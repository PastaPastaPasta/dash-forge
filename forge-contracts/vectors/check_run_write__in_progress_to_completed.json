{
  "name": "in_progress_to_completed",
  "description": "In progress to completed: a replace that sets completedAt only; the stored startedAt stays.",
  "case": "check_run_write",
  "rules": "v2",
  "input": {
    "stored": {
      "status": "in_progress",
      "startedAt": 100,
      "completedAt": null,
      "conclusion": null
