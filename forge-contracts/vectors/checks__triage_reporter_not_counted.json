  "rules": "v2",
  "input": {
    "runs": [
      {
        "id": "r1",
        "headOid": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "name": "build",
        "status": "completed",
        "reporter": "maint",
        "createdAt": 100,
        "conclusion": "failure"
      },
      {
        "id": "r2",
        "headOid": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "name": "build",
        "status": "completed",
        "reporter": "tri",
        "createdAt": 200,
        "conclusion": "success"
      }
    ],
    "headOid": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "memberships": [
      {
        "identity": "maint",
        "role": "maintainer",
        "createdAt": 10
      },
      {
        "identity": "tri",
        "role": "triage",
        "createdAt": 10
      }
    ],
    "policy": {
      "requiredChecks": [
        "build"
      ]
    }
  },
  "expected": {
    "required": [
      {
        "name": "build",
        "state": "failing",
